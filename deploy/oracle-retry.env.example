# Config for deploy/oracle-capacity-retry.sh.
#
# Copy to deploy/oracle-retry.env (gitignored) and fill in your own OCIDs:
#
#   cp deploy/oracle-retry.env.example deploy/oracle-retry.env
#   ./deploy/oracle-capacity-retry.sh --discover   # prints the values below
#
# OCIDs are account-specific identifiers, not secrets in the credential sense —
# but they're still yours, so the real file stays out of git.

# Your tenancy/compartment. --discover prints the tenancy OCID, which is the
# right answer unless you created a dedicated compartment.
COMPARTMENT_OCID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The PUBLIC subnet from your VCN. --discover marks each subnet public=YES/NO;
# picking the private one leaves the instance with no public IP and unreachable.
SUBNET_OCID=ocid1.subnet.oc1.eu-frankfurt-1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical Ubuntu 24.04 aarch64, matching the shape below.
IMAGE_OCID=ocid1.image.oc1.eu-frankfurt-1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Space-separated. All ADs in your home region — the script rotates through
# them, since capacity frees up in one at a time.
AVAILABILITY_DOMAINS="abcd:EU-FRANKFURT-1-AD-1 abcd:EU-FRANKFURT-1-AD-2 abcd:EU-FRANKFURT-1-AD-3"

# --- Optional overrides (defaults shown, set in the script) ---
# DISPLAY_NAME=turborepo-api
# SHAPE=VM.Standard.A1.Flex
# OCPUS=1
# MEMORY_GB=6
# SSH_KEY_FILE=$HOME/.ssh/oracle_turborepo.pub
# INTERVAL=90
