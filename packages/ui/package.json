    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
