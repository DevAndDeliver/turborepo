# Copy to .env. The API boots with none of this set — it just logs a warning
# and skips the email side.

# Server
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000

# Resend — https://resend.com. Unset, waitlist signups are still accepted and
# validated, they are just not stored or emailed.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Database (add your preferred DB — Postgres, SQLite, etc.)
# See "Example: adding Postgres + Prisma" in the README.
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Branding for the welcome email. MAIL_FROM must be an address on a domain you
# have verified with Resend, or every send is rejected. SITE_NAME is optional —
# unset, the subject line carries no suffix.
# MAIL_FROM=Your Name <noreply@yourdomain.com>
# SITE_URL=https://yourdomain.com
# SITE_NAME=Your Name
