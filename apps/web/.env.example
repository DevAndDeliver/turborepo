# Copy to .env.local. Everything below is optional — the app boots and renders
# with none of it set, using the demo defaults in src/lib/site.ts. Uncomment a
# line to override it. NEXT_PUBLIC_* is inlined at build time, so changing one
# in a hosting dashboard needs a redeploy, not just a save.

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Branding. Until you set these, the site identifies as Dev and Deliver —
# see "Making it yours" in the README for the full list of what to replace.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
# NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org/your-repo

# Cal — https://cal.com, or your own self-hosted instance.
# Unset, these point at Cal.com's own public demo event so the booking section
# renders on a fresh clone without booking into anybody's real calendar. Point
# them at yours before deploying.
# NEXT_PUBLIC_CAL_LINK is `username/event-type`, not a bare username.
# NEXT_PUBLIC_CAL_URL=https://cal.com
# NEXT_PUBLIC_CAL_LINK=your-username/15min

# Contentful — https://contentful.com. Optional: unset, the page renders the
# static fallback content in src/lib/contentful.ts.
# CONTENTFUL_MANAGEMENT_TOKEN is only needed to run `pnpm seed:contentful`.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_MANAGEMENT_TOKEN=
